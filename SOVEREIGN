        local label = Create("TextLabel", {Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 30, 0, 0), BackgroundTransparency = 1, Text = sub.Name, TextColor3 = Theme.TextMuted, Font = Theme.FontMed, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn})
        local indicator = Create("Frame", {Size = UDim2.new(0, 2, 0, 14), Position = UDim2.new(0, 0, 0.5, -7), BackgroundColor3 = Theme.Text, Visible = false, Parent = btn})
        
        btn.MouseEnter:Connect(function() if CurrentPage ~= sub.Target then Tween(btn, 0.1, {BackgroundColor3 = Theme.Panel}) end end)
        btn.MouseLeave:Connect(function() if CurrentPage ~= sub.Target then Tween(btn, 0.1, {BackgroundColor3 = Theme.Sidebar}) end end)
        
        btn.MouseButton1Click:Connect(function()
            SwitchPage(sub.Target, cat.Category .. " > " .. sub.Name)
        end)
        
        table.insert(NavButtons, {Frame = btn, Label = label, Indicator = indicator, Target = sub.Target})
    end
end

