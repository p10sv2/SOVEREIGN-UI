local function Notify(title, text, type)
    local color = type == "Premium" and Theme.Gold or (type == "Error" and Theme.Error or Theme.Accent)
    
    local notif = Create("Frame", {Size = UDim2.new(1, 0, 0, 65), BackgroundColor3 = Theme.Panel, BackgroundTransparency = 1, Parent = NotifHolder})
    AddCorner(notif, 8)
    local stroke = Create("UIStroke", {Color = color, Transparency = 1, Parent = notif})
    local bar = Create("Frame", {Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = color, BackgroundTransparency = 1, Parent = notif})
    AddCorner(bar, 4)

    local titleLbl = Create("TextLabel", {Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 15, 0, 10), BackgroundTransparency = 1, Text = title, TextColor3 = Theme.Text, Font = Theme.FontBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, Parent = notif})
    local textLbl = Create("TextLabel", {Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 15, 0, 30), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.TextMuted, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTransparency = 1, Parent = notif})

    Tween(notif, 0.3, {BackgroundTransparency = 0, Position = UDim2.new(0, -10, 0, 0)})
    Tween(stroke, 0.3, {Transparency = 0}) Tween(bar, 0.3, {BackgroundTransparency = 0})
    Tween(titleLbl, 0.3, {TextTransparency = 0}) Tween(textLbl, 0.3, {TextTransparency = 0})

    task.delay(4, function()
        Tween(notif, 0.3, {BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 0)})
        Tween(stroke, 0.3, {Transparency = 1}) Tween(bar, 0.3, {BackgroundTransparency = 1})
        Tween(titleLbl, 0.3, {TextTransparency = 1}) Tween(textLbl, 0.3, {TextTransparency = 1})
        task.wait(0.3) notif:Destroy()
    end)
end

