local function CreateToggle(parent, text, configTable, configKey, isPremium)
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Parent = parent})
    Create("TextLabel", {Size = UDim2.new(1, -60, 1, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    if isPremium then
        Create("ImageLabel", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -75, 0.5, -6), BackgroundTransparency = 1, Image = Icons.Target, ImageColor3 = Theme.Gold, Parent = container})
    end

    local toggleBg = Create("Frame", {Size = UDim2.new(0, 34, 0, 18), Position = UDim2.new(1, -34, 0.5, -9), BackgroundColor3 = configTable[configKey] and Theme.Accent or Theme.PanelHeader, Parent = container})
    AddCorner(toggleBg, 9)
    local toggleDot = Create("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = configTable[configKey] and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), BackgroundColor3 = Theme.Text, Parent = toggleBg})
    AddCorner(toggleDot, 7)

    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = container})
    btn.Selectable = true
    btn.MouseButton1Click:Connect(function()
        if isPremium and not Config.User.IsPremium then return end
        configTable[configKey] = not configTable[configKey]
        if configTable[configKey] then
            Tween(toggleBg, 0.1, {BackgroundColor3 = Theme.Accent})
            Tween(toggleDot, 0.1, {Position = UDim2.new(1, -16, 0.5, -7)})
        else
            Tween(toggleBg, 0.1, {BackgroundColor3 = Theme.PanelHeader})
            Tween(toggleDot, 0.1, {Position = UDim2.new(0, 2, 0.5, -7)})
        end
    end)
end

local function CreateSlider(parent, text, min, max, configTable, configKey)
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = parent})
    
    local textLbl = Create("TextLabel", {Size = UDim2.new(1, -50, 0, 16), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    local valLbl = Create("TextLabel", {Size = UDim2.new(0, 50, 0, 16), Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1, Text = tostring(configTable[configKey]), TextColor3 = Theme.TextMuted, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = container})

    local track = Create("Frame", {Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0, 24), BackgroundColor3 = Theme.PanelHeader, Parent = container})
    AddCorner(track, 2)
    
    local percent = (configTable[configKey] - min) / (max - min)
    local fill = Create("Frame", {Size = UDim2.new(percent, 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = track})
    AddCorner(fill, 2)
    
    local dot = Create("Frame", {Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(percent, -5, 0.5, -5), BackgroundColor3 = Theme.Text, Parent = track})
    AddCorner(dot, 5)

    local dragging = false
    local hitbox = Create("TextButton", {Size = UDim2.new(1, 0, 2, 0), Position = UDim2.new(0, 0, -0.5, 0), BackgroundTransparency = 1, Text = "", Parent = track})
    hitbox.Selectable = true

    local function update(x)
        local p = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local newVal = math.floor(min + (max - min) * p + 0.5)
        configTable[configKey] = newVal
        Tween(fill, 0.1, {Size = UDim2.new(p, 0, 1, 0)})
        Tween(dot, 0.1, {Position = UDim2.new(p, -5, 0.5, -5)})
        valLbl.Text = tostring(newVal)
    end

    hitbox.MouseButton1Down:Connect(function() dragging = true update(UserInputService:GetMouseLocation().X) end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local function CreateDropdown(parent, text, options, configTable, configKey)
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = parent, ZIndex = 2})
    Create("TextLabel", {Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    local dropBg = Create("Frame", {Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Theme.PanelHeader, Parent = container, ZIndex = 3})
    AddCorner(dropBg, 4)
    
    local txt = Create("TextLabel", {Size = UDim2.new(1, -25, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = configTable[configKey], TextColor3 = Theme.Text, Font = Theme.FontReg, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBg, ZIndex = 4})
    local arrow = Create("TextLabel", {Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -20, 0, 0), BackgroundTransparency = 1, Text = "▼", TextColor3 = Theme.TextMuted, TextSize = 8, Parent = dropBg, ZIndex = 4})
    
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = dropBg, ZIndex = 5})
    btn.Selectable = true
    
    local list = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 2), BackgroundColor3 = Theme.PanelHeader, ClipsDescendants = true, Visible = false, Parent = dropBg, ZIndex = 10})
    AddCorner(list, 4)
    Create("UIListLayout", {Padding = UDim.new(0, 1), Parent = list})
    
    local open = false
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            list.Visible = true
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, math.min(#options * 20, 100))})
            Tween(arrow, 0.2, {Rotation = 180})
        else
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
            Tween(arrow, 0.2, {Rotation = 0})
            task.wait(0.2) if not open then list.Visible = false end
        end
    end)

    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = Theme.PanelHeader, Text = opt, TextColor3 = Theme.TextMuted, Font = Theme.FontReg, TextSize = 11, Parent = list, ZIndex = 11})
        optBtn.MouseEnter:Connect(function() Tween(optBtn, 0.1, {TextColor3 = Theme.Text}) end)
        optBtn.MouseLeave:Connect(function() Tween(optBtn, 0.1, {TextColor3 = Theme.TextMuted}) end)
        optBtn.MouseButton1Click:Connect(function()
            configTable[configKey] = opt
            txt.Text = opt
            open = false
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
            Tween(arrow, 0.2, {Rotation = 0})
            task.wait(0.2) if not open then list.Visible = false end
        end)
    end
end


