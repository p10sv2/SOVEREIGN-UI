local function Notify(title, text, isPremiumError)
    local notif = Create("Frame", {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = Theme.Secondary, BackgroundTransparency = 1, Parent = NotifHolder})
    AddCorner(notif, 8)
    local stroke = Create("UIStroke", {Color = isPremiumError and Theme.Gold or Theme.Accent, Transparency = 1, Parent = notif})
    
    Create("TextLabel", {Size = UDim2.new(1, -10, 0, 20), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1, Text = title, TextColor3 = isPremiumError and Theme.Gold or Theme.Text, Font = Theme.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, Parent = notif}).Name = "Title"
    Create("TextLabel", {Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 0, 25), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.TextMuted, Font = Theme.Font, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTransparency = 1, Parent = notif}).Name = "Text"

    Tween(notif, 0.2, {BackgroundTransparency = 0})
    Tween(stroke, 0.2, {Transparency = 0})
    Tween(notif.Title, 0.2, {TextTransparency = 0})
    Tween(notif.Text, 0.2, {TextTransparency = 0})

    task.delay(3, function()
        Tween(notif, 0.2, {BackgroundTransparency = 1})
        Tween(stroke, 0.2, {Transparency = 1})
        Tween(notif.Title, 0.2, {TextTransparency = 1})
        Tween(notif.Text, 0.2, {TextTransparency = 1})
        task.wait(0.2)
        notif:Destroy()
    end)
end

