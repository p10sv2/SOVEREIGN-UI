local function CreateToggle(parent, text, configTable, configKey, isPremium)
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Parent = parent})
    Create("TextLabel", {Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    if isPremium then
        Create("TextLabel", {Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(1, -100, 0, 0), BackgroundTransparency = 1, Text = "👑 PREM", TextColor3 = Theme.Gold, Font = Theme.FontBold, TextSize = 10, Parent = container})
    end

    local toggleBg = Create("Frame", {Size = UDim2.new(0, 36, 0, 20), Position = UDim2.new(1, -36, 0.5, -10), BackgroundColor3 = configTable[configKey] and Theme.Accent or Theme.Panel, Parent = container})
    AddCorner(toggleBg, 10)
    local toggleDot = Create("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = configTable[configKey] and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Theme.Text, Parent = toggleBg})
    AddCorner(toggleDot, 7)

    local toggleBtn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = container})
    toggleBtn.MouseButton1Click:Connect(function()
        if isPremium and not _G.SOVEREIGN_CONFIG.Premium then
            Notify("Premium Required", "Upgrade to Sovereign Premium to use " .. text, true)
            return
        end
        
        configTable[configKey] = not configTable[configKey]
        if configTable[configKey] then
            Tween(toggleBg, 0.2, {BackgroundColor3 = Theme.Accent})
            Tween(toggleDot, 0.2, {Position = UDim2.new(1, -17, 0.5, -7)})
        else
            Tween(toggleBg, 0.2, {BackgroundColor3 = Theme.Panel})
            Tween(toggleDot, 0.2, {Position = UDim2.new(0, 3, 0.5, -7)})
        end
    end)
end

local function CreateSlider(parent, text, min, max, configTable, configKey, isPremium)
    local val = configTable[configKey]
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, Parent = parent})
    Create("TextLabel", {Size = UDim2.new(1, -50, 0, 20), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    local valueLabel = Create("TextLabel", {Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1, Text = isPremium and ("👑 " .. tostring(val)) or tostring(val), TextColor3 = isPremium and Theme.Gold or Theme.TextMuted, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = container})
    local sliderBg = Create("Frame", {Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 1, -12), BackgroundColor3 = Theme.Panel, Parent = container})
    AddCorner(sliderBg, 2)

    local percent = (val - min) / (max - min)
    local fill = Create("Frame", {Size = UDim2.new(percent, 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = sliderBg})
    AddCorner(fill, 2)
    local dot = Create("Frame", {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(percent, -6, 0.5, -6), BackgroundColor3 = Theme.Text, Parent = sliderBg})
    AddCorner(dot, 6)

    local isDragging = false
    local sliderBtn = Create("TextButton", {Size = UDim2.new(1, 0, 2, 0), Position = UDim2.new(0, 0, -0.5, 0), BackgroundTransparency = 1, Text = "", Parent = sliderBg})

    local function UpdateValue(x)
        local p = math.clamp((x - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local newValue = math.floor(min + (max - min) * p + 0.5)
        configTable[configKey] = newValue
        
        Tween(fill, 0.1, {Size = UDim2.new(p, 0, 1, 0)})
        Tween(dot, 0.1, {Position = UDim2.new(p, -6, 0.5, -6)})
        valueLabel.Text = isPremium and ("👑 " .. tostring(newValue)) or tostring(newValue)
    end

    sliderBtn.MouseButton1Down:Connect(function()
        if isPremium and not _G.SOVEREIGN_CONFIG.Premium then
            Notify("Premium Required", "Upgrade to Sovereign Premium to adjust " .. text, true)
            return
        end
        isDragging = true
        UpdateValue(UserInputService:GetMouseLocation().X)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateValue(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isDragging = false end
    end)
end

local function CreateDropdown(parent, text, options, configTable, configKey, isPremium)
    local currentVal = configTable[configKey]
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, Parent = parent, ZIndex = 2})
    Create("TextLabel", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    local dropBg = Create("Frame", {Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, 22), BackgroundColor3 = Theme.Panel, Parent = container, ZIndex = 3})
    AddCorner(dropBg, 6)
    local dropText = Create("TextLabel", {Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = currentVal, TextColor3 = isPremium and Theme.Gold or Theme.Text, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBg, ZIndex = 4})
    local arrow = Create("TextLabel", {Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -20, 0, 0), BackgroundTransparency = 1, Text = "▼", TextColor3 = Theme.TextMuted, TextSize = 10, Parent = dropBg, ZIndex = 4})
    
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = dropBg, ZIndex = 5})

    local open = false
    local list = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 5), BackgroundColor3 = Theme.Secondary, ClipsDescendants = true, Visible = false, Parent = dropBg, ZIndex = 10})
    AddCorner(list, 6) AddStroke(list)
    Create("UIListLayout", {Padding = UDim.new(0, 2), Parent = list})
    
    local function Close()
        open = false
        Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
        task.wait(0.2) if not open then list.Visible = false end
        Tween(arrow, 0.2, {Rotation = 0})
    end

    btn.MouseButton1Click:Connect(function()
        if isPremium and not _G.SOVEREIGN_CONFIG.Premium then
            Notify("Premium Required", "Upgrade to Sovereign Premium to change " .. text, true)
            return
        end
        
        open = not open
        if open then
            list.Visible = true
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, math.min(#options * 24, 120))})
            Tween(arrow, 0.2, {Rotation = 180})
        else
            Close()
        end
    end)

    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Secondary, Text = opt, TextColor3 = Theme.TextMuted, Font = Theme.Font, TextSize = 12, Parent = list, ZIndex = 11})
        optBtn.MouseEnter:Connect(function() Tween(optBtn, 0.1, {BackgroundColor3 = Theme.Panel, TextColor3 = Theme.Text}) end)
        optBtn.MouseLeave:Connect(function() Tween(optBtn, 0.1, {BackgroundColor3 = Theme.Secondary, TextColor3 = Theme.TextMuted}) end)
        
        optBtn.MouseButton1Click:Connect(function()
            configTable[configKey] = opt
            dropText.Text = isPremium and ("👑 " .. opt) or opt
            Close()
        end)
    end
end

