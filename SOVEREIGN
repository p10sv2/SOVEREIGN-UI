-- Search Logic
SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(SearchInput.Text)
    if query == "" then SwitchPage("Dashboard") return end
    local foundPage = nil
    for pageName, pageData in pairs(Pages) do
        local matchFound = false
        for _, keyword in ipairs(pageData.Keywords) do if string.find(keyword, query) or string.find(pageName:lower(), query) then matchFound = true break end end
        for _, v in ipairs(pageData.Frame:GetDescendants()) do if v:IsA("TextLabel") and string.find(v.Text:lower(), query) then matchFound = true break end end
        if matchFound then foundPage = pageName break end
    end
    if foundPage then SwitchPage(foundPage) end
end)

SwitchPage("Dashboard")

