local CurrentSelectionRing = nil
local IsUsingController = false

-- Track input type
UserInputService.LastInputTypeChanged:Connect(function(lastInputType)
    if lastInputType == Enum.UserInputType.Gamepad1 then
        IsUsingController = true
    elseif lastInputType == Enum.UserInputType.MouseButton1 or lastInputType == Enum.UserInputType.Keyboard then
        IsUsingController = false
    end
end)

-- Helper to apply a focus ring to any button
local function MakeFocusable(button, parentFrame)
    button.Selectable = true
    
    local ring = Create("UIStroke", {
        Color = Theme.Accent,
        Thickness = 2,
        Transparency = 1,
        Parent = parentFrame
    })
    
    button.SelectionGained:Connect(function()
        if IsUsingController then
            Tween(ring, 0.2, {Transparency = 0})
            Tween(parentFrame, 0.2, {BackgroundColor3 = Theme.PanelHover})
        end
    end)
    
    button.SelectionLost:Connect(function()
        Tween(ring, 0.2, {Transparency = 1})
        Tween(parentFrame, 0.2, {BackgroundColor3 = parentFrame:GetAttribute("BaseColor") or Theme.Panel})
    end)
    
    parentFrame:SetAttribute("BaseColor", parentFrame.BackgroundColor3)
end

