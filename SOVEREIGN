local CategoryDefs = {
    {Name = "Dashboard", Icon = "🏠"}, {Name = "Shooting", Icon = "🎯"},
    {Name = "Dribbling", Icon = "🏀"}, {Name = "Defense", Icon = "🛡️"}, {Name = "Settings", Icon = "⚙️"}
}

local function SwitchPage(pageName)
    CurrentPage = pageName
    Breadcrumb.Text = pageName
    for name, p in pairs(Pages) do p.Frame.Visible = (name == pageName) end
    
    for pName, btnData in pairs(NavButtons) do
        if pName == pageName then
            Tween(btnData.Frame, 0.2, {BackgroundColor3 = Theme.Panel})
            btnData.Label.TextColor3 = Theme.Text
            btnData.Indicator.Visible = true
            if IsUsingController then GuiService.SelectedObject = btnData.Frame end
        else
            Tween(btnData.Frame, 0.2, {BackgroundColor3 = Theme.Sidebar})
            btnData.Label.TextColor3 = Theme.TextMuted
            btnData.Indicator.Visible = false
        end
    end
end

for _, data in ipairs(CategoryDefs) do
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Sidebar, Text = "", Parent = NavHolder})
    AddCorner(btn, 6)
    MakeFocusable(btn, btn)
    
    Create("TextLabel", {Size = UDim2.new(0, 30, 1, 0), BackgroundTransparency = 1, Text = data.Icon, TextSize = 16, Parent = btn})
    local label = Create("TextLabel", {Size = UDim2.new(1, -35, 1, 0), Position = UDim2.new(0, 35, 0, 0), BackgroundTransparency = 1, Text = data.Name, TextColor3 = Theme.TextMuted, Font = Theme.FontMed, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn})
    local indicator = Create("Frame", {Size = UDim2.new(0, 3, 0, 18), Position = UDim2.new(0, 0, 0.5, -9), BackgroundColor3 = Theme.Accent, Visible = false, Parent = btn})
    AddCorner(indicator, 2)

    btn.MouseEnter:Connect(function() if CurrentPage ~= data.Name and not IsUsingController then Tween(btn, 0.2, {BackgroundColor3 = Theme.PanelHover}) end end)
    btn.MouseLeave:Connect(function() if CurrentPage ~= data.Name and not IsUsingController then Tween(btn, 0.2, {BackgroundColor3 = Theme.Sidebar}) end end)
    btn.MouseButton1Click:Connect(function() SwitchPage(data.Name) end)
    
    NavButtons[data.Name] = {Frame = btn, Label = label, Indicator = indicator}
end

