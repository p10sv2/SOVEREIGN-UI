    Create("TextLabel", {Size = UDim2.new(1, -80, 1, 0), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontMed, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    if isPremium then
        local badge = Create("Frame", {Size = UDim2.new(0, 45, 0, 16), Position = UDim2.new(1, -120, 0.5, -8), BackgroundColor3 = Theme.PanelHover, Parent = container})
        AddCorner(badge, 4)
        Create("TextLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "👑 PREM", TextColor3 = Theme.Gold, Font = Theme.FontBold, TextSize = 9, Parent = badge})
    end

    local toggleBg = Create("Frame", {Size = UDim2.new(0, 40, 0, 22), Position = UDim2.new(1, -40, 0.5, -11), BackgroundColor3 = configTable[configKey] and Theme.Accent or Theme.Sidebar, Parent = container})
    AddCorner(toggleBg, 11)
    local toggleDot = Create("Frame", {Size = UDim2.new(0, 16, 0, 16), Position = configTable[configKey] and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = Theme.Text, Parent = toggleBg})
    AddCorner(toggleDot, 8)

    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = container})
    btn.MouseButton1Click:Connect(function()
        if isPremium and not Config.User.IsPremium then
            Notify("Premium Required", "Upgrade to SOVEREIGN Premium to access " .. text, "Premium")
            return
        end
        configTable[configKey] = not configTable[configKey]
        if configTable[configKey] then
            Tween(toggleBg, 0.2, {BackgroundColor3 = Theme.Accent}, Enum.EasingStyle.Back)
            Tween(toggleDot, 0.2, {Position = UDim2.new(1, -18, 0.5, -8)}, Enum.EasingStyle.Back)
        else
            Tween(toggleBg, 0.2, {BackgroundColor3 = Theme.Sidebar}, Enum.EasingStyle.Back)
            Tween(toggleDot, 0.2, {Position = UDim2.new(0, 2, 0.5, -8)}, Enum.EasingStyle.Back)
        end
    end)
end

local function CreateSlider(parent, text, min, max, configTable, configKey, isPremium)
    local val = configTable[configKey]
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Parent = parent})
    Create("TextLabel", {Size = UDim2.new(1, -50, 0, 20), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontMed, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    local valLbl = Create("TextLabel", {Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1, Text = tostring(val), TextColor3 = Theme.Accent, Font = Theme.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, Parent = container})
    if isPremium then valLbl.TextColor3 = Theme.Gold end

    local track = Create("Frame", {Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0, 30), BackgroundColor3 = Theme.Sidebar, Parent = container})
    AddCorner(track, 3)
    
    local percent = (val - min) / (max - min)
    local fill = Create("Frame", {Size = UDim2.new(percent, 0, 1, 0), BackgroundColor3 = isPremium and Theme.Gold or Theme.Accent, Parent = track})
    AddCorner(fill, 3)
    
    local dot = Create("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(percent, -7, 0.5, -7), BackgroundColor3 = Theme.Text, Parent = track})
    AddCorner(dot, 7)

    local dragging = false
    local hitbox = Create("TextButton", {Size = UDim2.new(1, 0, 3, 0), Position = UDim2.new(0, 0, -1, 0), BackgroundTransparency = 1, Text = "", Parent = track})

    local function update(x)
        local p = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local newVal = math.floor(min + (max - min) * p + 0.5)
        configTable[configKey] = newVal
        Tween(fill, 0.1, {Size = UDim2.new(p, 0, 1, 0)})
        Tween(dot, 0.1, {Position = UDim2.new(p, -7, 0.5, -7)})
        valLbl.Text = tostring(newVal)
    end

    hitbox.MouseButton1Down:Connect(function()
        if isPremium and not Config.User.IsPremium then
            Notify("Premium Required", "Upgrade to SOVEREIGN Premium to adjust " .. text, "Premium")
            return
        end
        dragging = true update(UserInputService:GetMouseLocation().X)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local function CreateDropdown(parent, text, options, configTable, configKey, isPremium)
    local container = Create("Frame", {Size = UDim2.new(1, 0, 0, 45), BackgroundTransparency = 1, Parent = parent, ZIndex = 2})
    Create("TextLabel", {Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text, Font = Theme.FontMed, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = container})
    
    local dropBg = Create("Frame", {Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, 22), BackgroundColor3 = Theme.Sidebar, Parent = container, ZIndex = 3})
    AddCorner(dropBg, 6) AddStroke(dropBg, Theme.PanelHover)
    
    local txt = Create("TextLabel", {Size = UDim2.new(1, -30, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = configTable[configKey], TextColor3 = isPremium and Theme.Gold or Theme.Text, Font = Theme.FontReg, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = dropBg, ZIndex = 4})
    local arrow = Create("TextLabel", {Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -25, 0, 0), BackgroundTransparency = 1, Text = "▼", TextColor3 = Theme.TextMuted, TextSize = 10, Parent = dropBg, ZIndex = 4})
    
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = dropBg, ZIndex = 5})
    
    local list = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 1, 5), BackgroundColor3 = Theme.Sidebar, ClipsDescendants = true, Visible = false, Parent = dropBg, ZIndex = 10})
    AddCorner(list, 6) AddStroke(list, Theme.PanelHover)
    Create("UIListLayout", {Padding = UDim.new(0, 2), Parent = list})
    
    local open = false
    local function toggleList()
        if isPremium and not Config.User.IsPremium then
            Notify("Premium Required", "Upgrade to SOVEREIGN Premium to change " .. text, "Premium")
            return
        end
        open = not open
        if open then
            list.Visible = true
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, math.min(#options * 24, 120))})
            Tween(arrow, 0.2, {Rotation = 180})
        else
            Tween(list, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
            Tween(arrow, 0.2, {Rotation = 0})
            task.wait(0.2) if not open then list.Visible = false end
        end
    end

    btn.MouseButton1Click:Connect(toggleList)

    for _, opt in ipairs(options) do
        local optBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Sidebar, Text = opt, TextColor3 = Theme.TextMuted, Font = Theme.FontReg, TextSize = 12, Parent = list, ZIndex = 11})
        optBtn.MouseEnter:Connect(function() Tween(optBtn, 0.1, {BackgroundColor3 = Theme.PanelHover, TextColor3 = Theme.Text}) end)
        optBtn.MouseLeave:Connect(function() Tween(optBtn, 0.1, {BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextMuted}) end)
        optBtn.MouseButton1Click:Connect(function()
            configTable[configKey] = opt
            txt.Text = opt
            toggleList()
        end)
    end
end

