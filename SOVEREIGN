    {Name = "Dribbling", Icon = "🏀", Page = "Dribbling"},
    {Name = "Defense", Icon = "🛡️", Page = "Defense"},
    {Name = "Settings", Icon = "⚙️", Page = "Settings"},
}

local function SwitchPage(pageName)
    ActiveTab = pageName
    for name, p in pairs(Pages) do p.Visible = (name == pageName) end
    
    for pName, btnData in pairs(NavButtons) do
        if pName == pageName then
            Tween(btnData.Button, 0.2, {BackgroundColor3 = Theme.Panel})
            btnData.Label.TextColor3 = Theme.Text
            btnData.Indicator.Visible = true
        else
            Tween(btnData.Button, 0.2, {BackgroundColor3 = Theme.Secondary})
            btnData.Label.TextColor3 = Theme.TextMuted
            btnData.Indicator.Visible = false
        end
    end
end

for _, data in ipairs(Categories) do
    local btn = Create("TextButton", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.Secondary, Text = "", Parent = Sidebar})
    AddCorner(btn, 8)
    Create("TextLabel", {Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(0, 5, 0, 0), BackgroundTransparency = 1, Text = data.Icon, TextSize = 16, Parent = btn})
    local label = Create("TextLabel", {Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 35, 0, 0), BackgroundTransparency = 1, Text = data.Name, TextColor3 = Theme.TextMuted, Font = Theme.FontBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn})
    local indicator = Create("Frame", {Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 0, 0.5, -8), BackgroundColor3 = Theme.Accent, Visible = false, Parent = btn})
    AddCorner(indicator, 2)

    btn.MouseEnter:Connect(function() if ActiveTab ~= data.Page then Tween(btn, 0.2, {BackgroundColor3 = Theme.Panel}) end end)
    btn.MouseLeave:Connect(function() if ActiveTab ~= data.Page then Tween(btn, 0.2, {BackgroundColor3 = Theme.Secondary}) end end)
    btn.MouseButton1Click:Connect(function() SwitchPage(data.Page) end)
    
    NavButtons[data.Page] = {Button = btn, Label = label, Indicator = indicator}
end

-- Functional Search Filter
SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(SearchInput.Text)
    if query == "" then
        SwitchPage("Dashboard")
        return
    end
    
    -- Simple Search Routing Logic
    local found = false
    for pageName, pageObj in pairs(Pages) do
        for _, child in ipairs(pageObj:GetDescendants()) do
            if child:IsA("TextLabel") and string.find(string.lower(child.Text), query) then
                SwitchPage(pageName)
                found = true
                break
            end
        end
        if found then break end
    end
end)

-- Initialization
SwitchPage("Dashboard")

