-- ==========================================
local function GetChar() return LocalPlayer.Character, LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") end

RunService.Heartbeat:Connect(function()
    local char, hum = GetChar()
    if not char or not hum then return end
    if Config.Dribbling.Glide.Enabled then
        if hum.MoveDirection.Magnitude > 0 then hum.WalkSpeed = Config.Dribbling.Glide.DribbleSpeed else hum.WalkSpeed = 16 end
    else
        if hum.WalkSpeed == Config.Dribbling.Glide.DribbleSpeed then hum.WalkSpeed = 16 end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if Config.Defense.Guard.Enabled then
            local char, hum = GetChar()
            if not char or not hum then continue end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            local closest, dist = nil, Config.Defense.Guard.Distance + 5
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if pRoot and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                        if Config.Defense.Guard.TeamCheck and p.Team == LocalPlayer.Team then continue end
                        local d = (root.Position - pRoot.Position).Magnitude
                        if d < dist then dist = d closest = p end
                    end
                end
            end
            if closest then
                local look = CFrame.lookAt(root.Position, Vector3.new(closest.Character.HumanoidRootPart.Position.X, root.Position.Y, closest.Character.HumanoidRootPart.Position.Z))
                root.CFrame = root.CFrame:Lerp(look, 0.2)
            end
        end
    end
end)

